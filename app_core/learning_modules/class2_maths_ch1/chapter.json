  "sections": [
    {
      "id": "sec1",
      "title": "Repeated Addition",
      "blocks": [
        {
          "id": "blk1",
          "type": "theory",
          "metadata": {
            "difficulty": "Intermediate",
            "estimated_minutes": 5,
            "bloom": "Understand"
          },
          "content": {
            "text": "Multiplication is a fast way to add the same number again and again. 2 + 2 + 2 = 6 is the same as 3 times 2 (3 x 2 = 6)."
          }
        },
        {
          "id": "blk2",
          "type": "mcq",
          "metadata": {
            "difficulty": "Intermediate",
            "estimated_minutes": 5,
            "bloom": "Apply"
          },
          "content": {
            "question": "Which of these is the same as 4 x 2?",
            "options": [
              "4 + 2",
              "2 + 2 + 2 + 2",
              "4 + 4 + 4 + 4"
            ],
            "correct_index": 1,
            "explanation": "4 x 2 means four groups of 2 (2 + 2 + 2 + 2)."
          }
        }
      ]
    },
    {
      "id": "sec2",
      "title": "Multiplying by 0 and 1",
      "blocks": [
        {
          "id": "blk3",
          "type": "theory",
          "metadata": {
            "difficulty": "Intermediate",
            "estimated_minutes": 5,
            "bloom": "Understand"
          },
          "content": {
            "text": "Any number multiplied by 1 stays the same (5 x 1 = 5). Any number multiplied by 0 becomes 0 (5 x 0 = 0)."
          }
        },
        {
          "id": "blk4",
          "type": "mcq",
          "metadata": {
            "difficulty": "Intermediate",
            "estimated_minutes": 4,
            "bloom": "Apply"
          },
          "content": {
            "question": "What is 9 x 0?",
            "options": [
              "9",
              "1",
              "0"
            ],
            "correct_index": 2,
            "explanation": "Anything multiplied by 0 is 0!"
          }
        }
      ]
    }
  ]
