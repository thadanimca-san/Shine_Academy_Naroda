  "sections": [
    {
      "id": "sec1",
      "title": "What is Addition?",
      "blocks": [
        {
          "id": "blk1",
          "type": "theory",
          "metadata": {
            "difficulty": "Beginner",
            "estimated_minutes": 5,
            "bloom": "Understand"
          },
          "content": {
            "text": "Addition means putting things together. When you have 2 apples 🍎🍎 and get 1 more 🍎, you have 3 apples in total!"
          }
        },
        {
          "id": "blk2",
          "type": "mcq",
          "metadata": {
            "difficulty": "Beginner",
            "estimated_minutes": 5,
            "bloom": "Apply"
          },
          "content": {
            "question": "What is 3 + 2?",
            "options": [
              "4",
              "5",
              "6"
            ],
            "correct_index": 1,
            "explanation": "If you have 3 and add 2 more, you get 5!"
          }
        }
      ]
    },
    {
      "id": "sec2",
      "title": "Adding with Zero",
      "blocks": [
        {
          "id": "blk3",
          "type": "theory",
          "metadata": {
            "difficulty": "Beginner",
            "estimated_minutes": 3,
            "bloom": "Understand"
          },
          "content": {
            "text": "Zero (0) means nothing. If you add 0 to any number, the number stays exactly the same!"
          }
        },
        {
          "id": "blk4",
          "type": "mcq",
          "metadata": {
            "difficulty": "Beginner",
            "estimated_minutes": 2,
            "bloom": "Apply"
          },
          "content": {
            "question": "What is 7 + 0?",
            "options": [
              "0",
              "8",
              "7"
            ],
            "correct_index": 2,
            "explanation": "7 plus nothing is still 7!"
          }
        }
      ]
    }
  ]
