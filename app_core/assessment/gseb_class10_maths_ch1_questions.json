    {
      "id": "Q_NCERT_10_CH1_PRACTICE_001",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_1_Q1",
      "type": "mcq",
      "difficulty": "Beginner",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 1,
      "bloom_taxonomy": "Understanding",
      "question_text": {
        "english": "What is the prime factorization of 140?",
        "hindi": "140 \u0915\u093e \u0905\u092d\u093e\u091c\u094d\u092f \u0917\u0941\u0923\u0928\u0916\u0902\u0921\u0928 \u0915\u094d\u092f\u093e \u0939\u0948?"
      },
      "options": [
        {
          "english": "2\u00b2 \u00d7 5 \u00d7 7",
          "hindi": "2\u00b2 \u00d7 5 \u00d7 7"
        },
        {
          "english": "2 \u00d7 5\u00b2 \u00d7 7",
          "hindi": "2 \u00d7 5\u00b2 \u00d7 7"
        },
        {
          "english": "2\u00b2 \u00d7 3 \u00d7 7",
          "hindi": "2\u00b2 \u00d7 3 \u00d7 7"
        },
        {
          "english": "2\u00b3 \u00d7 5 \u00d7 7",
          "hindi": "2\u00b3 \u00d7 5 \u00d7 7"
        }
      ],
      "correct_index": 0,
      "explanation": {
        "english": "140 = 2 \u00d7 70 = 2 \u00d7 2 \u00d7 35 = 2\u00b2 \u00d7 5 \u00d7 7.",
        "hindi": "140 = 2 \u00d7 70 = 2 \u00d7 2 \u00d7 35 = 2\u00b2 \u00d7 5 \u00d7 7\u0964"
      },
      "distractor_rationale": {
        "english": "Keep dividing by 2 until you get an odd number, then try 3, 5, etc.",
        "hindi": "2 \u0938\u0947 \u0924\u092c \u0924\u0915 \u092d\u093e\u0917 \u0926\u0947\u0902 \u091c\u092c \u0924\u0915 \u0935\u093f\u0937\u092e \u0938\u0902\u0916\u094d\u092f\u093e \u0928 \u092e\u093f\u0932 \u091c\u093e\u090f, \u092b\u093f\u0930 3, 5, \u0906\u0926\u093f \u0915\u093e \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
      },
      "ai_context": {
        "learning_goal": "Test basic prime factorization.",
        "common_misconceptions": [
          "Students may include composite numbers in the factor tree."
        ],
        "hint": "Divide by the smallest prime number first."
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_002",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_1_Q2",
      "type": "mcq",
      "difficulty": "Intermediate",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 2,
      "bloom_taxonomy": "Applying",
      "question_text": {
        "english": "Find the LCM of 26 and 91.",
        "hindi": "26 \u0914\u0930 91 \u0915\u093e LCM \u091c\u094d\u091e\u093e\u0924 \u0915\u0940\u091c\u093f\u090f\u0964"
      },
      "options": [
        {
          "english": "13",
          "hindi": "13"
        },
        {
          "english": "182",
          "hindi": "182"
        },
        {
          "english": "2366",
          "hindi": "2366"
        },
        {
          "english": "91",
          "hindi": "91"
        }
      ],
      "correct_index": 1,
      "explanation": {
        "english": "26 = 2 \u00d7 13. 91 = 7 \u00d7 13. LCM = 2 \u00d7 7 \u00d7 13 = 182.",
        "hindi": "26 = 2 \u00d7 13. 91 = 7 \u00d7 13. LCM = 2 \u00d7 7 \u00d7 13 = 182."
      },
      "distractor_rationale": {
        "english": "13 is the HCF, not LCM. 2366 is the product.",
        "hindi": "13 HCF \u0939\u0948, LCM \u0928\u0939\u0940\u0902\u0964 2366 \u0938\u0902\u0916\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u0917\u0941\u0923\u0928\u092b\u0932 \u0939\u0948\u0964"
      },
      "ai_context": {
        "learning_goal": "Calculate LCM using prime factorization.",
        "common_misconceptions": [
          "Confusing HCF and LCM calculations."
        ],
        "hint": "Take the highest power of all prime factors involved."
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_003",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_1_Q4",
      "type": "mcq",
      "difficulty": "Intermediate",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 2,
      "bloom_taxonomy": "Applying",
      "question_text": {
        "english": "Given that HCF (306, 657) = 9, what is LCM (306, 657)?",
        "hindi": "\u0926\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948 \u0915\u093f HCF (306, 657) = 9, LCM (306, 657) \u0915\u094d\u092f\u093e \u0939\u0948?"
      },
      "options": [
        {
          "english": "22338",
          "hindi": "22338"
        },
        {
          "english": "22383",
          "hindi": "22383"
        },
        {
          "english": "34",
          "hindi": "34"
        },
        {
          "english": "73",
          "hindi": "73"
        }
      ],
      "correct_index": 0,
      "explanation": {
        "english": "LCM = (Product of numbers) / HCF = (306 \u00d7 657) / 9 = 34 \u00d7 657 = 22338.",
        "hindi": "LCM = (\u0938\u0902\u0916\u094d\u092f\u093e\u0913\u0902 \u0915\u093e \u0917\u0941\u0923\u0928\u092b\u0932) / HCF = (306 \u00d7 657) / 9 = 34 \u00d7 657 = 22338."
      },
      "distractor_rationale": {
        "english": "Use the formula HCF \u00d7 LCM = a \u00d7 b.",
        "hindi": "HCF \u00d7 LCM = a \u00d7 b \u0938\u0942\u0924\u094d\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
      },
      "ai_context": {
        "learning_goal": "Apply the HCF \u00d7 LCM relationship formula.",
        "common_misconceptions": [
          "Students may try to prime factorize these large numbers, wasting time."
        ],
        "hint": "Remember: HCF \u00d7 LCM = Product of the two numbers."
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_004",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_1_Q5",
      "type": "true_false",
      "difficulty": "Advanced",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 1,
      "bloom_taxonomy": "Analyzing",
      "question_text": {
        "english": "The number 6\u207f can end with the digit 0 for any natural number n.",
        "hindi": "\u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u093e\u0915\u0943\u0924 \u0938\u0902\u0916\u094d\u092f\u093e n \u0915\u0947 \u0932\u093f\u090f 6\u207f \u0905\u0902\u0915 0 \u092a\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
      },
      "options": [
        {
          "english": "True",
          "hindi": "\u0938\u0924\u094d\u092f"
        },
        {
          "english": "False",
          "hindi": "\u0905\u0938\u0924\u094d\u092f"
        }
      ],
      "correct_index": 1,
      "explanation": {
        "english": "False. For a number to end in 0, its prime factorization must contain both 2 and 5. The prime factorization of 6 is 2 \u00d7 3, which lacks 5.",
        "hindi": "\u0905\u0938\u0924\u094d\u092f\u0964 \u0915\u093f\u0938\u0940 \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u094b 0 \u092a\u0930 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0909\u0938\u0915\u0947 \u0905\u092d\u093e\u091c\u094d\u092f \u0917\u0941\u0923\u0928\u0916\u0902\u0921\u0928 \u092e\u0947\u0902 2 \u0914\u0930 5 \u0926\u094b\u0928\u094b\u0902 \u0939\u094b\u0928\u0947 \u091a\u093e\u0939\u093f\u090f\u0964 6 \u0915\u093e \u0905\u092d\u093e\u091c\u094d\u092f \u0917\u0941\u0923\u0928\u0916\u0902\u0921\u0928 2 \u00d7 3 \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 5 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
      },
      "distractor_rationale": {
        "english": "Think about the prime factors required to make a 10.",
        "hindi": "10 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u0935\u0936\u094d\u092f\u0915 \u0905\u092d\u093e\u091c\u094d\u092f \u0917\u0941\u0923\u0928\u0916\u0902\u0921\u094b\u0902 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0938\u094b\u091a\u0947\u0902\u0964"
      },
      "ai_context": {
        "learning_goal": "Understand the role of prime factors 2 and 5 in determining trailing zeros.",
        "common_misconceptions": [
          "Thinking any even number to a power might end in 0."
        ],
        "hint": "What primes multiply to make 10?"
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_005",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_1_Q7",
      "type": "mcq",
      "difficulty": "Advanced",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 3,
      "bloom_taxonomy": "Evaluating",
      "question_text": {
        "english": "Sonia takes 18 mins to drive one round of a field, while Ravi takes 12 mins. If they start at the same point and time and go in the same direction, after how many minutes will they meet again at the starting point?",
        "hindi": "\u0938\u094b\u0928\u093f\u092f\u093e \u0915\u094b \u092e\u0948\u0926\u093e\u0928 \u0915\u093e \u090f\u0915 \u091a\u0915\u094d\u0915\u0930 \u0932\u0917\u093e\u0928\u0947 \u092e\u0947\u0902 18 \u092e\u093f\u0928\u091f \u0932\u0917\u0924\u0947 \u0939\u0948\u0902, \u091c\u092c\u0915\u093f \u0930\u0935\u093f \u0915\u094b 12 \u092e\u093f\u0928\u091f \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0935\u0947 \u090f\u0915 \u0939\u0940 \u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u0938\u092e\u092f \u0938\u0947 \u090f\u0915 \u0939\u0940 \u0926\u093f\u0936\u093e \u092e\u0947\u0902 \u091a\u0932\u0928\u093e \u092a\u094d\u0930\u093e\u0930\u0902\u092d \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0915\u093f\u0924\u0928\u0947 \u092e\u093f\u0928\u091f \u092c\u093e\u0926 \u0935\u0947 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u093e\u0930\u0902\u092d\u093f\u0915 \u0938\u094d\u0925\u093e\u0928 \u092a\u0930 \u092e\u093f\u0932\u0947\u0902\u0917\u0947?"
      },
      "options": [
        {
          "english": "6 minutes",
          "hindi": "6 \u092e\u093f\u0928\u091f"
        },
        {
          "english": "24 minutes",
          "hindi": "24 \u092e\u093f\u0928\u091f"
        },
        {
          "english": "36 minutes",
          "hindi": "36 \u092e\u093f\u0928\u091f"
        },
        {
          "english": "72 minutes",
          "hindi": "72 \u092e\u093f\u0928\u091f"
        }
      ],
      "correct_index": 2,
      "explanation": {
        "english": "They will meet again at the LCM of their times. LCM(18, 12) = 36. So, they meet after 36 minutes.",
        "hindi": "\u0935\u0947 \u0905\u092a\u0928\u0947 \u0938\u092e\u092f \u0915\u0947 LCM \u092a\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092e\u093f\u0932\u0947\u0902\u0917\u0947\u0964 LCM(18, 12) = 36. \u0907\u0938\u0932\u093f\u090f, \u0935\u0947 36 \u092e\u093f\u0928\u091f \u092c\u093e\u0926 \u092e\u093f\u0932\u0924\u0947 \u0939\u0948\u0902\u0964"
      },
      "distractor_rationale": {
        "english": "6 is the HCF. We need the LCM to find when they sync up again in the future.",
        "hindi": "6 HCF \u0939\u0948\u0964 \u092d\u0935\u093f\u0937\u094d\u092f \u092e\u0947\u0902 \u0935\u0947 \u092b\u093f\u0930 \u0938\u0947 \u0915\u092c \u092e\u093f\u0932\u0947\u0902\u0917\u0947, \u092f\u0939 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u0947\u0902 LCM \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0939\u0948\u0964"
      },
      "ai_context": {
        "learning_goal": "Apply LCM to solve real-world cyclic synchronization problems.",
        "common_misconceptions": [
          "Students often calculate HCF instead of LCM for this type of problem."
        ],
        "hint": "Since time is passing forward, the answer must be larger than both 18 and 12. Use LCM."
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_006",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_2_Q1",
      "type": "mcq",
      "difficulty": "Intermediate",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 1,
      "bloom_taxonomy": "Understanding",
      "question_text": {
        "english": "The number \u221a5 is a/an:",
        "hindi": "\u0938\u0902\u0916\u094d\u092f\u093e \u221a5 \u0915\u094d\u092f\u093e \u0939\u0948?"
      },
      "options": [
        {
          "english": "Integer",
          "hindi": "\u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915"
        },
        {
          "english": "Rational number",
          "hindi": "\u092a\u0930\u093f\u092e\u0947\u092f \u0938\u0902\u0916\u094d\u092f\u093e"
        },
        {
          "english": "Irrational number",
          "hindi": "\u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0938\u0902\u0916\u094d\u092f\u093e"
        },
        {
          "english": "Whole number",
          "hindi": "\u092a\u0942\u0930\u094d\u0923 \u0938\u0902\u0916\u094d\u092f\u093e"
        }
      ],
      "correct_index": 2,
      "explanation": {
        "english": "\u221a5 cannot be expressed as a simple fraction p/q (proved by contradiction), so it is an irrational number.",
        "hindi": "\u221a5 \u0915\u094b \u0938\u0930\u0932 \u092d\u093f\u0928\u094d\u0928 p/q \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0935\u094d\u092f\u0915\u094d\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948 (\u0935\u093f\u0930\u094b\u0927\u093e\u092d\u093e\u0938 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u093f\u0926\u094d\u0927), \u0907\u0938\u0932\u093f\u090f \u092f\u0939 \u090f\u0915 \u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0938\u0902\u0916\u094d\u092f\u093e \u0939\u0948\u0964"
      },
      "distractor_rationale": {
        "english": "The square root of any non-perfect square is irrational.",
        "hindi": "\u0915\u093f\u0938\u0940 \u092d\u0940 \u0917\u0948\u0930-\u092a\u0942\u0930\u094d\u0923 \u0935\u0930\u094d\u0917 \u0915\u093e \u0935\u0930\u094d\u0917\u092e\u0942\u0932 \u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
      },
      "ai_context": {
        "learning_goal": "Identify basic irrational numbers.",
        "common_misconceptions": [
          "Students confuse irrational numbers with repeating decimals."
        ],
        "hint": "Is 5 a perfect square?"
      }
    },
    {
      "id": "Q_NCERT_10_CH1_PRACTICE_007",
      "chapter_id": "NCERT_MATH_10_CH1_LEARN",
      "topic_id": "KOBJ_EX1_2_Q2",
      "type": "mcq",
      "difficulty": "Intermediate",
      "board": [
        "NCERT",
        "CBSE",
        "GSEB"
      ],
      "marks": 1,
      "bloom_taxonomy": "Understanding",
      "question_text": {
        "english": "The number 3 + 2\u221a5 is:",
        "hindi": "\u0938\u0902\u0916\u094d\u092f\u093e 3 + 2\u221a5 \u0915\u094d\u092f\u093e \u0939\u0948?"
      },
      "options": [
        {
          "english": "Always rational",
          "hindi": "\u0939\u092e\u0947\u0936\u093e \u092a\u0930\u093f\u092e\u0947\u092f"
        },
        {
          "english": "Always irrational",
          "hindi": "\u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0930\u093f\u092e\u0947\u092f"
        },
        {
          "english": "Can be rational or irrational",
          "hindi": "\u092a\u0930\u093f\u092e\u0947\u092f \u092f\u093e \u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948"
        },
        {
          "english": "An integer",
          "hindi": "\u090f\u0915 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915"
        }
      ],
      "correct_index": 1,
      "explanation": {
        "english": "The sum of a rational number (3) and an irrational number (2\u221a5) is always irrational.",
        "hindi": "\u090f\u0915 \u092a\u0930\u093f\u092e\u0947\u092f \u0938\u0902\u0916\u094d\u092f\u093e (3) \u0914\u0930 \u090f\u0915 \u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0938\u0902\u0916\u094d\u092f\u093e (2\u221a5) \u0915\u093e \u092f\u094b\u0917 \u0939\u092e\u0947\u0936\u093e \u0905\u092a\u0930\u093f\u092e\u0947\u092f \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
      },
      "distractor_rationale": {
        "english": "Remember the rule: rational + irrational = irrational.",
        "hindi": "\u0928\u093f\u092f\u092e \u092f\u093e\u0926 \u0930\u0916\u0947\u0902: \u092a\u0930\u093f\u092e\u0947\u092f + \u0905\u092a\u0930\u093f\u092e\u0947\u092f = \u0905\u092a\u0930\u093f\u092e\u0947\u092f\u0964"
      },
      "ai_context": {
        "learning_goal": "Understand properties of operations on irrational numbers.",
