      "content": "**\u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0ac1\u0a82 \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8**: \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0acb \u0aa7\u0a82\u0aa7\u0acb \u0a95\u0abe\u0aaf\u0aae \u0aae\u0abe\u0a9f\u0ac7 \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ab5\u0acb \u0a85\u0aa8\u0ac7 \u0aa4\u0aae\u0abe\u0aae \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0ab5\u0a9a\u0acd\u0a9a\u0ac7\u0aa8\u0abe \u0ab8\u0a82\u0aac\u0a82\u0aa7\u0aa8\u0acb \u0ab8\u0a82\u0aaa\u0ac2\u0ab0\u0acd\u0aa3 \u0a85\u0a82\u0aa4 \u0ab2\u0abe\u0ab5\u0ab5\u0acb."
