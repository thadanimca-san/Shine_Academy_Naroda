      "content": "**\u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac1\u0a82**: \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0ab8\u0aae\u0aaf\u0ac7 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0acb \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a95\u0ab0\u0ab5\u0abe \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a82 \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0abe \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0a96\u0acb\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0aa4\u0ac1\u0a82 \u0a96\u0abe\u0aa4\u0ac1\u0a82."
