    {
      "type": "theory",
      "content": "### 6. \u0aa8\u0ab9\u0ac0\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0ac0 \u0aa8\u0acb\u0a82\u0aa7\n\n- **\u0aa8\u0ab9\u0ac0\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0ab5\u0ac7\u0a9a\u0abe\u0aaf:** \u0a9c\u0acb \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0aa8 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0ab0\u0a95\u0aae \u0a89\u0aaa\u0a9c\u0ac7, \u0aa4\u0acb \u0aa4\u0ac7 \u0ab8\u0ac0\u0aa7\u0ac0 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0aa5\u0abe\u0aaf \u0a9b\u0ac7. (\u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7: \u0ab0\u0acb\u0a95\u0aa1/\u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 \u0aa4\u0ac7 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7).\n- **\u0aa8\u0ab9\u0ac0\u0a82 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aa6\u0ac7\u0ab5\u0ac1\u0a82 \u0a9a\u0ac2\u0a95\u0ab5\u0abe\u0aaf:** \u0a9c\u0acb \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0aa8 \u0aa8\u0acb\u0a82\u0aa7\u0abe\u0aaf\u0ac7\u0ab2 \u0aa6\u0ac7\u0ab5\u0ac1\u0a82 \u0a9a\u0ac2\u0a95\u0ab5\u0abe\u0aaf, \u0aa4\u0acb \u0aa4\u0ac7 \u0ab8\u0ac0\u0aa7\u0ac1\u0a82 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 \u0a89\u0aa7\u0abe\u0ab0 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7. (\u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7: \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 \u0aa4\u0ac7 \u0ab0\u0acb\u0a95\u0aa1/\u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0ac7)."
    },
