    {
      "type": "example",
      "content": "### \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 1: \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0ac0 \u0aab\u0ac7\u0ab0\u0aac\u0aa6\u0ab2\u0ac0\n\n**\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0:** X \u0a85\u0aa8\u0ac7 Y \u0aa8\u0abe \u0aaa\u0abe\u0a95\u0abe \u0ab8\u0ab0\u0ab5\u0ac8\u0aaf\u0abe\u0aae\u0abe\u0a82 \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0acb \u20b9 50,000, \u0aa6\u0ac7\u0ab5\u0abe\u0aa6\u0abe\u0ab0\u0acb \u20b9 20,000 \u0a85\u0aa8\u0ac7 \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb \u20b9 30,000 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0a9b\u0ac7. \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0ab8\u0aae\u0aaf\u0ac7 \u0a86 \u0a96\u0abe\u0aa4\u0abe \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ab5\u0abe\u0aa8\u0ac0 \u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7 \u0ab2\u0a96\u0acb.\n\n**\u0a89\u0a95\u0ac7\u0ab2:**\n1. \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0abe \u0a96\u0abe\u0aa4\u0abe \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7:\n\u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 70,000\n  \u0aa4\u0ac7 \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0acb \u0a96\u0abe\u0aa4\u0ac7 ... 50,000\n  \u0aa4\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0aa6\u0abe\u0ab0\u0acb \u0a96\u0abe\u0aa4\u0ac7 ... 20,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0abe \u0a96\u0abe\u0aa4\u0abe \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ac0 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 \u0ab2\u0a88 \u0a97\u0aaf\u0abe \u0aa4\u0ac7\u0aa8\u0abe)\n\n2. \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0abe \u0a96\u0abe\u0aa4\u0abe \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7:\n\u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 30,000\n  \u0aa4\u0ac7 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... 30,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac1\u0a82 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ac0 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 \u0ab2\u0a88 \u0a97\u0aaf\u0abe \u0aa4\u0ac7\u0aa8\u0abe)"
    },
    {
      "type": "example",
      "content": "### \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 2: \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0ac1\u0a82 \u0ab5\u0ac7\u0a9a\u0abe\u0aa3 \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0\n\n**\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0:** \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 1 \u0aa8\u0abe \u0a86\u0aa7\u0abe\u0ab0\u0ac7, \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0abe \u20b9 45,000 \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe \u20b9 18,000 \u0a8a\u0aaa\u0a9c\u0acd\u0aaf\u0abe. \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u20b9 28,000 \u0a9a\u0ac2\u0a95\u0ab5\u0ac0 \u0ab9\u0abf\u0ab8\u0abe\u0aac \u0a9a\u0ac1\u0a95\u0aa4\u0ac7 \u0a95\u0ab0\u0acd\u0aaf\u0acb. \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0a96\u0ab0\u0acd\u0a9a \u20b9 2,000 \u0aa5\u0aaf\u0acb.\n\n**\u0a89\u0a95\u0ac7\u0ab2:**\n1. \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0abe \u0ab5\u0ac7\u0a9a\u0abe\u0aa3 \u0aae\u0abe\u0a9f\u0ac7:\n\u0ab0\u0acb\u0a95\u0aa1/\u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 63,000\n  \u0aa4\u0ac7 \u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... 63,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0abe 45k \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe 18k \u0a8a\u0aaa\u0a9c\u0acd\u0aaf\u0abe \u0aa4\u0ac7\u0aa8\u0abe)\n\n2. \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7:\n\u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 28,000\n  \u0aa4\u0ac7 \u0ab0\u0acb\u0a95\u0aa1/\u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0ac7 ... 28,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac7 \u0ab9\u0abf\u0ab8\u0abe\u0aac \u0a9a\u0ac1\u0a95\u0aa4\u0ac7 \u0ab0\u0a95\u0aae \u0a9a\u0ac2\u0a95\u0ab5\u0ac0 \u0aa4\u0ac7\u0aa8\u0abe)\n\n3. \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0a96\u0ab0\u0acd\u0a9a\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0 \u0aae\u0abe\u0a9f\u0ac7:\n\u0aae\u0abe\u0ab2-\u0aae\u0abf\u0ab2\u0a95\u0aa4 \u0aa8\u0abf\u0a95\u0abe\u0ab2 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 2,000\n  \u0aa4\u0ac7 \u0ab0\u0acb\u0a95\u0aa1/\u0aac\u0ac7\u0a82\u0a95 \u0a96\u0abe\u0aa4\u0ac7 ... 2,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0a96\u0ab0\u0acd\u0a9a \u0a9a\u0ac2\u0a95\u0ab5\u0acd\u0aaf\u0acb \u0aa4\u0ac7\u0aa8\u0abe)"
    },
    {
      "type": "quiz",
      "question": "\u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0ab8\u0aae\u0aaf\u0ac7 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0abe \u0a96\u0abe\u0aa4\u0abe \u0aac\u0a82\u0aa7 \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0a95\u0aaf\u0ac1\u0a82 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a96\u0acb\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7?",
