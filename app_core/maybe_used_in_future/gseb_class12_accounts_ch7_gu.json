    {
      "type": "theory",
      "content": "### 5. \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0\u0aa8\u0acb \u0a95\u0acd\u0ab0\u0aae (\u0a95\u0ab2\u0aae 48)\n\n\u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0ac1\u0a82 \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0aa5\u0abe\u0aaf, \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb\u0aa8\u0abe \u0ab5\u0ac7\u0a9a\u0abe\u0aa3\u0aae\u0abe\u0a82\u0aa5\u0ac0 \u0a8a\u0aaa\u0a9c\u0ac7\u0ab2\u0ac0 \u0ab0\u0a95\u0aae \u0aa8\u0ac0\u0a9a\u0ac7\u0aa8\u0abe \u0a95\u0abe\u0aa8\u0ac2\u0aa8\u0ac0 \u0a95\u0acd\u0ab0\u0aae\u0aae\u0abe\u0a82 \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7:\n1. \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0a96\u0ab0\u0acd\u0a9a\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0.\n2. \u0aa4\u0acd\u0ab0\u0abe\u0ab9\u0abf\u0aa4 \u0aaa\u0a95\u0acd\u0ab7\u0a95\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aa6\u0ac7\u0ab5\u0abe\u0a82\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0 (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0ab2\u0ac7\u0aa3\u0aa6\u0abe\u0ab0\u0acb, \u0aac\u0ac7\u0a82\u0a95 \u0ab2\u0acb\u0aa8).\n3. \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0a8f \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0ac7 \u0a86\u0aaa\u0ac7\u0ab2\u0ac0 \u0ab2\u0acb\u0aa8\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0.\n4. \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac0 \u0aae\u0ac2\u0aa1\u0ac0\u0aa8\u0ac0 \u0a9a\u0ac2\u0a95\u0ab5\u0aa3\u0ac0.\n5. \u0a9c\u0acb \u0ab0\u0a95\u0aae \u0ab5\u0aa7\u0ac7, \u0aa4\u0acb \u0aa4\u0ac7 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0ab5\u0a9a\u0acd\u0a9a\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82 \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0ac0 \u0aa6\u0ac7\u0ab5\u0abe\u0aaf \u0a9b\u0ac7."
