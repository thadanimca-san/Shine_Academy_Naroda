    {
      "type": "definition",
      "content": "**\u0aa8\u0ab5\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0aa8\u0acb \u0aaa\u0acd\u0ab0\u0ab5\u0ac7\u0ab6**: \u0a9a\u0abe\u0ab2\u0ac1 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0ac0 \u0aaa\u0ac7\u0aa2\u0ac0\u0aae\u0abe\u0a82 \u0aa4\u0aae\u0abe\u0aae \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0ac0 \u0ab8\u0a82\u0aae\u0aa4\u0abf\u0aa5\u0ac0 \u0aa8\u0ab5\u0ac0 \u0ab5\u0acd\u0aaf\u0a95\u0acd\u0aa4\u0abf\u0aa8\u0ac7 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0 \u0aa4\u0ab0\u0ac0\u0a95\u0ac7 \u0aa6\u0abe\u0a96\u0ab2 \u0a95\u0ab0\u0ab5\u0ac0."
