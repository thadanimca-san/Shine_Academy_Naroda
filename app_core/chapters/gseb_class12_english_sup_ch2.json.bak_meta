  "id": "GSEB_C12_ENG_SUP_CH2",
  "title": "Her Words, His Vision",
  "title_hi": "उसके शब्द, उसकी दृष्टि",
  "title_gu": "તેના શબ્દો, તેની દ્રષ્ટિ",
