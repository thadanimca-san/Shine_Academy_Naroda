    },
    {
      "type": "knowledge_check",
      "content": {
        "question": ": If two quantities increase together, they are in",
        "options": [
          "No proportion",
          "Inverse proportion",
          "Equal proportion",
          "Direct proportion"
        ],
        "correct_answer": "Direct proportion",
        "explanation": "Correct answer as per the question bank."
