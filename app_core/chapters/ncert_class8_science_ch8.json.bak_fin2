      "id": "KOBJ_NCERT_CLASS8_SCIENCE_CH8_KNOW_004"
    },
    {
      "type": "knowledge_check",
      "content": {
        "question": ": Which of these is a non-contact force?",
        "options": [
          "Muscular force",
          "Friction",
          "Magnetic force",
          "Tension"
        ],
        "correct_answer": "Magnetic force",
        "explanation": "Correct answer as per the question bank."
