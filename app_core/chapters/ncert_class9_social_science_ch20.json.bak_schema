  },
  {
    "id": "BLK_FS_07",
    "type": "theory",
    "difficulty": "Intermediate",
    "estimated_minutes": 3,
    "bloom": "Understand",
    "content": "Why is Food Security needed? The poorest sections of society might be food insecure most of the times while persons above the poverty line might also be food insecure when the country faces a national disaster/calamity like an earthquake, drought, flood, or tsunami.",
    "body": "Why is Food Security needed? The poorest sections of society might be food insecure most of the times while persons above the poverty line might also be food insecure when the country faces a national disaster/calamity like an earthquake, drought, flood, or tsunami."
  },
  {
    "id": "BLK_FS_08",
    "type": "real_world_example",
    "difficulty": "Intermediate",
    "estimated_minutes": 3,
    "bloom": "Evaluate",
    "content": "Case Study: The Bengal Famine of 1943. It was the most devastating famine that occurred in India, killing over 30 lakh people in the province of Bengal. It teaches us why building buffer stocks and a robust distribution system is critical to national survival.",
    "body": "Case Study: The Bengal Famine of 1943. It was the most devastating famine that occurred in India, killing over 30 lakh people in the province of Bengal. It teaches us why building buffer stocks and a robust distribution system is critical to national survival."
  },
  {
    "id": "BLK_FS_09",
    "type": "theory",
    "difficulty": "Intermediate",
    "estimated_minutes": 4,
    "bloom": "Understand",
    "content": "Who are food insecure? Although a large section of people suffer from food and nutrition insecurity in India, the worst affected groups are landless people with little or no land to depend upon, traditional artisans, providers of traditional services, petty self-employed workers, and destitutes.",
    "body": "Who are food insecure? Although a large section of people suffer from food and nutrition insecurity in India, the worst affected groups are landless people with little or no land to depend upon, traditional artisans, providers of traditional services, petty self-employed workers, and destitutes."
  },
  {
    "id": "BLK_FS_10",
    "type": "formula",
    "difficulty": "Advanced",
    "estimated_minutes": 5,
    "bloom": "Analyze",
    "content": "Step-by-Step Build: How does the government ensure Food Security?\nStep 1: The government agencies (like FCI) procure food from farmers who have a surplus.\nStep 2: They build a 'Buffer Stock' (a reserve of foodgrains).\nStep 3: This food is then distributed to the deficit areas and poorer strata of society through the Public Distribution System (PDS).",
    "body": "Step-by-Step Build: How does the government ensure Food Security?\nStep 1: The government agencies (like FCI) procure food from farmers who have a surplus.\nStep 2: They build a 'Buffer Stock' (a reserve of foodgrains).\nStep 3: This food is then distributed to the deficit areas and poorer strata of society through the Public Distribution System (PDS)."
  },
  {
    "id": "BLK_FS_11",
    "type": "definition",
    "difficulty": "Intermediate",
    "estimated_minutes": 2,
    "bloom": "Remember",
    "content": "Buffer Stock: It is the stock of foodgrains, namely wheat and rice, procured by the government through the Food Corporation of India (FCI). It is used to distribute foodgrains in deficit areas and among the poorer strata of society at a price lower than the market price, known as the Issue Price.",
    "body": "Buffer Stock: It is the stock of foodgrains, namely wheat and rice, procured by the government through the Food Corporation of India (FCI). It is used to distribute foodgrains in deficit areas and among the poorer strata of society at a price lower than the market price, known as the Issue Price."
  },
  {
    "id": "BLK_FS_12",
    "type": "theory",
    "difficulty": "Intermediate",
    "estimated_minutes": 3,
    "bloom": "Understand",
    "content": "Minimum Support Price (MSP): The farmers are paid a pre-announced price for their crops. This price is called MSP. The MSP is declared by the government every year before the sowing season to provide incentives to farmers for raising the production of these crops.",
    "body": "Minimum Support Price (MSP): The farmers are paid a pre-announced price for their crops. This price is called MSP. The MSP is declared by the government every year before the sowing season to provide incentives to farmers for raising the production of these crops."
  },
  {
    "id": "BLK_FS_13",
    "type": "definition",
    "difficulty": "Beginner",
    "estimated_minutes": 2,
    "bloom": "Remember",
    "content": "Etymology: The term 'Public Distribution System (PDS)'. 'Public' means for the people, 'Distribution' (from Latin distributio) means dealing out in shares, and 'System' means an organized framework. So, PDS is an organized framework to deal out food shares to the people.",
    "body": "Etymology: The term 'Public Distribution System (PDS)'. 'Public' means for the people, 'Distribution' (from Latin distributio) means dealing out in shares, and 'System' means an organized framework. So, PDS is an organized framework to deal out food shares to the people."
  },
  {
    "id": "BLK_FS_14",
    "type": "theory",
    "difficulty": "Intermediate",
    "estimated_minutes": 3,
    "bloom": "Understand",
    "content": "Ration Shops (Fair Price Shops): The food procured by the FCI is distributed through government-regulated ration shops among the poorer sections of the society. Ration shops are now present in most localities, villages, towns, and cities. There are about 5.5 lakh ration shops all over the country.",
    "body": "Ration Shops (Fair Price Shops): The food procured by the FCI is distributed through government-regulated ration shops among the poorer sections of the society. Ration shops are now present in most localities, villages, towns, and cities. There are about 5.5 lakh ration shops all over the country."
  },
