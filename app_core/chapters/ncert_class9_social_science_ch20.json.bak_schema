  {
    "id": "BLK_FS_03",
    "type": "definition",
    "difficulty": "Beginner",
    "estimated_minutes": 2,
    "bloom": "Remember",
    "content": "Etymology: The word 'Security' comes from the Latin 'securus', meaning 'free from care or danger'. Therefore, 'Food Security' means a state where a nation and its citizens are free from the danger of hunger and starvation.",
    "body": "Etymology: The word 'Security' comes from the Latin 'securus', meaning 'free from care or danger'. Therefore, 'Food Security' means a state where a nation and its citizens are free from the danger of hunger and starvation."
  },
