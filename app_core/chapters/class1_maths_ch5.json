      "type": "theory",
      "title": "Reading a Clock",
      "body": "The small hand shows the Hour.\nThe big hand shows the Minutes.\nIf the big hand is on 12, it is exactly that hour (e.g., 3 O'Clock).",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_MAT_5_05",
      "type": "quiz",
      "question": "If the short hand is on 4, and the long hand is on 12, what time is it?",
      "options": [
        "12 O'Clock",
        "4 O'Clock",
        "4:12"
      ],
      "correct_index": 1,
      "explanation": "It is exactly 4 O'Clock!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Apply"
