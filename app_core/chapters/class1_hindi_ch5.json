  "blocks": [
    {
      "id": "KOBJ_C1_HIN_5_01",
      "type": "hook",
      "title": "Short 'i' and Long 'ee'",
      "body": "Some sounds are quick like a mouse (i), and some stretch out (ee)!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_HIN_5_02",
      "type": "quiz",
      "question": "Which Matra comes BEFORE the letter?",
      "options": [
        "Badi Ee ( ी )",
        "Chhoti i ( ि )"
      ],
      "correct_index": 1,
      "explanation": "Chhoti 'i' comes before the letter!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Apply"
    },
    {
      "id": "KOBJ_C1_HIN_5_03",
      "type": "theory",
      "title": "Chhoti i ( ि )",
      "body": "It makes a quick 'i' sound.\nद + ि + न = दिन (Day)",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_HIN_5_04",
      "type": "flashcard",
      "front": "द + ि + न =",
      "back": "दिन (Day)",
      "color": "0xFFFF9800",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
    {
      "id": "KOBJ_C1_HIN_5_05",
      "type": "theory",
      "title": "Badi Ee ( ी )",
      "body": "It makes a long 'ee' sound and comes AFTER the letter.\nप + ा + न + ी = पानी (Water)",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_HIN_5_06",
      "type": "flashcard",
      "front": "प + ा + न + ी =",
      "back": "पानी (Water)",
      "color": "0xFF03A9F4",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
    {
      "id": "KOBJ_C1_HIN_5_07",
      "type": "teacher_tip",
      "title": "Front or Back?",
      "body": "Chhoti i stands IN FRONT of the letter. Badi Ee stands BEHIND it!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
