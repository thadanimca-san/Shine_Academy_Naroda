      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
    {
      "id": "KOBJ_C1_HIN_3_06",
      "type": "teacher_tip",
      "title": "No extra sounds",
      "body": "When you read a bina matra word, don't stretch the sounds. Just say them quickly!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
    {
      "id": "KOBJ_C1_HIN_3_07",
      "type": "theory",
      "title": "Three-letter words",
      "body": "क + म + ल = कमल (Lotus)\nम + ट + र = मटर (Peas)",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
