      "id": "KOBJ_C1_HIN_3_01",
      "type": "hook",
      "title": "Building Words!",
      "body": "We don't need any special marks (matras) to make our first Hindi words!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_HIN_3_02",
      "type": "quiz",
      "question": "What happens when you join ज and ल?",
      "options": [
        "कल",
        "जल",
        "फल"
      ],
      "correct_index": 1,
      "explanation": "ज + ल = जल (Water)!",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Apply"
    },
    {
      "id": "KOBJ_C1_HIN_3_03",
      "type": "flashcard",
      "front": "ज + ल =",
      "back": "जल (Water)",
      "color": "0xFF00BCD4",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Understand"
    },
    {
      "id": "KOBJ_C1_HIN_3_04",
      "type": "theory",
      "title": "Two-letter words",
      "body": "Just say the sounds together.\nघ + र = घर (House)\nफ + ल = फल (Fruit)",
      "difficulty": "Beginner",
      "estimated_minutes": 2,
      "bloom": "Remember"
    },
    {
      "id": "KOBJ_C1_HIN_3_05",
      "type": "flashcard",
