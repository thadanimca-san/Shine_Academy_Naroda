[
  {
    "block_id": "BLK_CH10_01",
    "type": "theory",
    "title": "Introduction to Natural Vegetation",
    "content": "Natural vegetation refers to a plant community that has grown naturally without human aid and has been left undisturbed by humans for a long time. This is termed as virgin vegetation.",
    "universal_block_metadata": {
      "difficulty": "Beginner",
      "estimated_minutes": 3,
      "bloom": "Understand"
    },
    "id": "KOBJ_CLAS_SOCI_SCIE_CH10_THEO_001",
    "title_hi": "Introduction to Natural Vegetation",
    "title_gu": "Introduction to Natural Vegetation",
    "body": "Natural vegetation refers to a plant community that has grown naturally without human aid and has been left undisturbed by humans for a long time. This is termed as virgin vegetation."
  },
