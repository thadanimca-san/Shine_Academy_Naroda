      "content": "**\u0ab2\u0abe\u0aad\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3**: \u0a9c\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82 \u0a9a\u0abe\u0ab2\u0ac1 \u0ab0\u0ab9\u0ac7\u0aa4\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0aa8\u0abf\u0ab5\u0ac3\u0aa4\u0acd\u0aa4 \u0a95\u0ac7 \u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1 \u0aaa\u0abe\u0aae\u0aa8\u0abe\u0ab0 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0aa8\u0acb \u0aa8\u0aab\u0abe\u0aa8\u0acb \u0aad\u0abe\u0a97 \u0aae\u0ac7\u0ab3\u0ab5\u0ac7 \u0a9b\u0ac7 \u0aa4\u0ac7 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3."
