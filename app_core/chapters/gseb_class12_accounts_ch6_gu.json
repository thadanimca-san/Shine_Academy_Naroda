        "\u0aa4\u0ac7 \u0aac\u0aa7\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aae\u0ac2\u0aa1\u0ac0 \u0a96\u0abe\u0aa4\u0ac7 \u0a9c\u0aae\u0abe \u0aa5\u0abe\u0aaf \u0a9b\u0ac7",
        "\u0aa4\u0ac7 \u0aac\u0aa7\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aae\u0ac2\u0aa1\u0ac0 \u0a96\u0abe\u0aa4\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe \u0a9c\u0ac2\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82 \u0a89\u0aa7\u0abe\u0ab0 \u0a95\u0ab0\u0ac0 \u0aae\u0abe\u0a82\u0aa1\u0ac0 \u0ab5\u0ab3\u0abe\u0aaf \u0a9b\u0ac7",
