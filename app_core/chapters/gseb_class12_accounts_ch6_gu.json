    {
      "type": "theory",
      "content": "### 6. \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0aa8\u0ac1\u0a82 \u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1\n\n\u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0aa8\u0abe \u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1\u0aa8\u0abe \u0ab8\u0a82\u0a9c\u0acb\u0a97\u0acb\u0aae\u0abe\u0a82 \u0ab9\u0abf\u0ab8\u0abe\u0aac\u0ac0 \u0a85\u0ab8\u0ab0\u0acb \u0ab2\u0a97\u0aad\u0a97 \u0aa8\u0abf\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf \u0a9c\u0ac7\u0ab5\u0ac0 \u0a9c \u0ab9\u0acb\u0aaf \u0a9b\u0ac7. \u0aae\u0ac1\u0a96\u0acd\u0aaf \u0aa4\u0aab\u0abe\u0ab5\u0aa4 \u0a8f \u0a9b\u0ac7 \u0a95\u0ac7 \u0aa8\u0abf\u0ab5\u0ac3\u0aa4\u0acd\u0aa4\u0abf \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0ab0\u0ac0\u0aa4\u0ac7 \u0ab9\u0abf\u0ab8\u0abe\u0aac\u0ac0 \u0ab5\u0ab0\u0acd\u0ab7\u0aa8\u0abe \u0a85\u0a82\u0aa4\u0ac7 \u0aa5\u0abe\u0aaf \u0a9b\u0ac7, \u0a9c\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1 \u0ab5\u0ab0\u0acd\u0ab7 \u0aa6\u0ab0\u0aae\u0abf\u0aaf\u0abe\u0aa8 \u0a97\u0aae\u0ac7 \u0aa4\u0acd\u0aaf\u0abe\u0ab0\u0ac7 \u0aa5\u0a88 \u0ab6\u0a95\u0ac7 \u0a9b\u0ac7.\n\n\u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1 \u0aaa\u0abe\u0aae\u0aa8\u0abe\u0ab0 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0aa8\u0ac0 \u0ab2\u0ac7\u0aa3\u0ac0 \u0ab0\u0a95\u0aae \u0aa4\u0ac7\u0aa8\u0abe \u0ab2\u0acb\u0aa8 \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0ac7 \u0aac\u0aa6\u0ab2\u0ac7 \u0aa4\u0ac7\u0aa8\u0abe **\u0ab5\u0abe\u0ab0\u0ab8\u0aa6\u0abe\u0ab0 (Executor) \u0aa8\u0abe \u0a96\u0abe\u0aa4\u0abe\u0aae\u0abe\u0a82** \u0aab\u0ac7\u0ab0\u0ab5\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa8\u0ac7 \u0ab5\u0ab0\u0acd\u0ab7\u0aa8\u0ac0 \u0ab6\u0ab0\u0ac2\u0a86\u0aa4\u0aa5\u0ac0 \u0aae\u0ac3\u0aa4\u0acd\u0aaf\u0ac1\u0aa8\u0ac0 \u0aa4\u0abe\u0ab0\u0ac0\u0a96 \u0ab8\u0ac1\u0aa7\u0ac0\u0aa8\u0abe \u0aa8\u0aab\u0abe\u0aae\u0abe\u0a82 \u0aaa\u0aa3 \u0aad\u0abe\u0a97 \u0aae\u0ab3\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7 \u0a8f\u0a95 \u0a96\u0abe\u0ab8 **\u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a89\u0aaa\u0ab2\u0a95 \u0a96\u0abe\u0aa4\u0abe (P&L Suspense A/c)** \u0aa6\u0acd\u0ab5\u0abe\u0ab0\u0abe \u0a86\u0aaa\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7."
    },
