    {
      "type": "example",
      "content": "### \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 1: \u0aa4\u0acd\u0aaf\u0abe\u0a97 \u0a85\u0aa8\u0ac7 \u0ab2\u0abe\u0aad\u0aa8\u0ac0 \u0a97\u0aa3\u0aa4\u0ab0\u0ac0\n\n**\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0:** A \u0a85\u0aa8\u0ac7 B \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0abe 3:2 \u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82 \u0aa8\u0aab\u0acb-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0aa4\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0a9b\u0ac7. \u0aad\u0ab5\u0abf\u0ab7\u0acd\u0aaf\u0aae\u0abe\u0a82 \u0aa8\u0aab\u0acb-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0ab8\u0ab0\u0a96\u0ac7 \u0ab9\u0abf\u0ab8\u0acd\u0ab8\u0ac7 (1:1) \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0ab5\u0abe\u0aa8\u0ac1\u0a82 \u0aa8\u0a95\u0acd\u0a95\u0ac0 \u0a95\u0ab0\u0acd\u0aaf\u0ac1\u0a82 \u0a9b\u0ac7. \u0aa4\u0acd\u0aaf\u0abe\u0a97 \u0a95\u0ac7 \u0ab2\u0abe\u0aad \u0a97\u0aa3\u0acb.\n\n**\u0a89\u0a95\u0ac7\u0ab2:**\n\u0a9c\u0ac2\u0aa8\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3 (A:B) = 3:2 (A = 3/5, B = 2/5)\n\u0aa8\u0ab5\u0ac1\u0a82 \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3 (A:B) = 1:1 (A = 1/2, B = 1/2)\n\n\u0ab8\u0ac2\u0aa4\u0acd\u0ab0: \u0aa4\u0acd\u0aaf\u0abe\u0a97 = \u0a9c\u0ac2\u0aa8\u0acb \u0aad\u0abe\u0a97 - \u0aa8\u0ab5\u0acb \u0aad\u0abe\u0a97\nA \u0aa8\u0acb \u0aad\u0abe\u0a97 = (3/5) - (1/2) = (6 - 5) / 10 = +1/10 (\u0aa4\u0acd\u0aaf\u0abe\u0a97)\nB \u0aa8\u0acb \u0aad\u0abe\u0a97 = (2/5) - (1/2) = (4 - 5) / 10 = -1/10 (\u0ab2\u0abe\u0aad)\n\n**\u0aaa\u0ab0\u0abf\u0aa3\u0abe\u0aae:** A \u0a8f 1/10 \u0aad\u0abe\u0a97\u0aa8\u0acb \u0aa4\u0acd\u0aaf\u0abe\u0a97 \u0a95\u0ab0\u0acd\u0aaf\u0acb \u0a9b\u0ac7, \u0a85\u0aa8\u0ac7 B \u0aa8\u0ac7 1/10 \u0aad\u0abe\u0a97\u0aa8\u0acb \u0ab2\u0abe\u0aad \u0aae\u0ab3\u0acd\u0aaf\u0acb \u0a9b\u0ac7."
    },
    {
      "type": "example",
      "content": "### \u0a89\u0aa6\u0abe\u0ab9\u0ab0\u0aa3 2: \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0ac0 \u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7\n\n**\u0aae\u0abe\u0ab9\u0abf\u0aa4\u0ac0:** \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0acb\u0aa8\u0ac0 \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0a95\u0abf\u0a82\u0aae\u0aa4 \u20b9 50,000 \u0a9b\u0ac7. \u0aa4\u0ac7\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4 \u20b9 60,000 \u0a97\u0aa3\u0ab5\u0ac0. \u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7 \u0ab2\u0a96\u0acb.\n\n**\u0a89\u0a95\u0ac7\u0ab2:**\n\u0a85\u0ab9\u0ac0\u0a82 \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u20b9 10,000 \u0aa8\u0acb \u0ab5\u0aa7\u0abe\u0ab0\u0acb \u0aa5\u0aaf\u0acb \u0a9b\u0ac7 (\u0aab\u0abe\u0aaf\u0aa6\u0acb \u0a9b\u0ac7), \u0aa4\u0ac7\u0aa5\u0ac0 \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a9c\u0aae\u0abe \u0aa5\u0ab6\u0ac7.\n\n**\u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7:**\n\u0aaf\u0a82\u0aa4\u0acd\u0ab0 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0 \u20b9 10,000\n  \u0aa4\u0ac7 \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0ac7 ... \u20b9 10,000\n(\u0aac\u0abe.\u0a9c\u0ac7. \u0aaa\u0ac1\u0aa8\u0ab0\u0acd\u0a97\u0aa0\u0aa8 \u0ab5\u0a96\u0aa4\u0ac7 \u0aaf\u0a82\u0aa4\u0acd\u0ab0\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u20b9 10,000 \u0aa8\u0acb \u0ab5\u0aa7\u0abe\u0ab0\u0acb \u0aa5\u0aaf\u0acb \u0aa4\u0ac7\u0aa8\u0abe)"
    },
    {
      "type": "quiz",
      "question": "\u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a95\u0aaf\u0abe \u0aaa\u0acd\u0ab0\u0a95\u0abe\u0ab0\u0aa8\u0ac1\u0a82 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a9b\u0ac7?",
      "options": [
