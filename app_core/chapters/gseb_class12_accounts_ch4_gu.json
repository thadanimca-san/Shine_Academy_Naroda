    {
      "type": "theory",
      "content": "### 6. \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0aa8\u0aab\u0abe \u0a85\u0aa8\u0ac7 \u0a85\u0aa8\u0abe\u0aae\u0aa4\u0acb\u0aa8\u0ac0 \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0aa3\u0ac0\n\n\u0aaa\u0ac1\u0aa8\u0ab0\u0acd\u0a97\u0aa0\u0aa8 \u0ab5\u0a96\u0aa4\u0ac7 \u0aaa\u0abe\u0a95\u0abe \u0ab8\u0ab0\u0ab5\u0ac8\u0aaf\u0abe\u0aae\u0abe\u0a82 \u0aa6\u0ab0\u0acd\u0ab6\u0abe\u0ab5\u0ac7\u0ab2 \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0aa8\u0aab\u0acb, \u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a85\u0aa8\u0abe\u0aae\u0aa4 \u0a95\u0ac7 \u0a85\u0aa8\u0abe\u0aae\u0aa4 \u0aad\u0a82\u0aa1\u0acb\u0ab3 \u0a9c\u0ac2\u0aa8\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0ab5\u0a9a\u0acd\u0a9a\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe **\u0a9c\u0ac2\u0aa8\u0abe \u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82** \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0ac0 \u0aa6\u0ac7\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.\n\n**\u0a85\u0aa8\u0abe\u0aae\u0aa4\u0acb\u0aa8\u0ac0 \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0aa3\u0ac0\u0aa8\u0ac0 \u0a86\u0aae\u0aa8\u0acb\u0a82\u0aa7:**\n\u0ab8\u0abe\u0aae\u0abe\u0aa8\u0acd\u0aaf \u0a85\u0aa8\u0abe\u0aae\u0aa4 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0\n\u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a96\u0abe\u0aa4\u0ac7 (\u0a9c\u0aae\u0abe \u0aac\u0abe\u0a95\u0ac0) ... \u0a89\u0aa7\u0abe\u0ab0\n\u0a95\u0abe\u0ab0\u0ac0\u0a97\u0ab0 \u0a85\u0a95\u0ab8\u0acd\u0aae\u0abe\u0aa4 \u0ab5\u0ab3\u0aa4\u0ab0 \u0aad\u0a82\u0aa1\u0acb\u0ab3 \u0a96\u0abe\u0aa4\u0ac7 ... \u0a89\u0aa7\u0abe\u0ab0\n  \u0aa4\u0ac7 \u0a9c\u0ac2\u0aa8\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aae\u0ac2\u0aa1\u0ac0/\u0a9a\u0abe\u0ab2\u0ac1 \u0a96\u0abe\u0aa4\u0ac7 (\u0a9c\u0ac2\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82)\n\n\u0aa4\u0ac7\u0ab5\u0ac0 \u0a9c \u0ab0\u0ac0\u0aa4\u0ac7, \u0a8f\u0a95\u0aa4\u0acd\u0ab0\u0abf\u0aa4 \u0a96\u0acb\u0a9f (\u0a9c\u0ac7\u0aae \u0a95\u0ac7 \u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0ac0 \u0a89\u0aa7\u0abe\u0ab0 \u0aac\u0abe\u0a95\u0ac0, \u0a9c\u0abe\u0ab9\u0ac7\u0ab0\u0abe\u0aa4 \u0a9d\u0ac1\u0a82\u0aac\u0ac7\u0ab6 \u0a96\u0ab0\u0acd\u0a9a) \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb\u0aa8\u0abe \u0aae\u0ac2\u0aa1\u0ac0 \u0a96\u0abe\u0aa4\u0ac7 \u0a9c\u0ac2\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82 \u0a89\u0aa7\u0abe\u0ab0\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7."
    },
