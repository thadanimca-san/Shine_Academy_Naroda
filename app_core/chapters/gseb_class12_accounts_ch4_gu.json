      "content": "**\u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0ac0\u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0aa8\u0ab0\u0acd\u0a97\u0aa0\u0aa8**: \u0a9c\u0ac1\u0aa6\u0abe \u0a9c\u0ac1\u0aa6\u0abe \u0a95\u0abe\u0ab0\u0aa3\u0acb\u0ab8\u0ab0 \u0a9a\u0abe\u0ab2\u0ac1 \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0ac0 \u0a95\u0ab0\u0abe\u0ab0\u0aae\u0abe\u0a82 \u0aa5\u0aa4\u0acb \u0aab\u0ac7\u0ab0\u0aab\u0abe\u0ab0 (\u0a9c\u0ac7\u0aae\u0abe\u0a82 \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0ac1\u0a82 \u0ab5\u0abf\u0ab8\u0ab0\u0acd\u0a9c\u0aa8 \u0aa5\u0aa4\u0ac1\u0a82 \u0aa8\u0aa5\u0ac0)."
