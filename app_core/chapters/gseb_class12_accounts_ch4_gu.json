    {
      "type": "theory",
      "content": "### 5. \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0ac1\u0a82 \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8\n\n\u0aaa\u0ac1\u0aa8\u0ab0\u0acd\u0a97\u0aa0\u0aa8 \u0ab5\u0a96\u0aa4\u0ac7 \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0ac0 \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0acb \u0a85\u0aa8\u0ac7 \u0aa6\u0ac7\u0ab5\u0abe\u0a93\u0aa8\u0ac0 \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aa8\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0ac0 \u0ab9\u0abe\u0ab2\u0aa8\u0ac0 \u0aac\u0a9c\u0abe\u0ab0 \u0a95\u0abf\u0a82\u0aae\u0aa4 \u0aae\u0ac1\u0a9c\u0aac \u0aab\u0ab0\u0ac0\u0aa5\u0ac0 \u0a86\u0a82\u0a95\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aa8\u0ac7 \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a95\u0ab9\u0ac7 \u0a9b\u0ac7. \u0a86 \u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8\u0aa5\u0ac0 \u0aa5\u0aa4\u0acb \u0aa8\u0aab\u0acb \u0a95\u0ac7 \u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0a9c\u0ac2\u0aa8\u0abe \u0aad\u0abe\u0a97\u0ac0\u0aa6\u0abe\u0ab0\u0acb \u0ab5\u0a9a\u0acd\u0a9a\u0ac7 \u0aa4\u0ac7\u0aae\u0aa8\u0abe **\u0a9c\u0ac2\u0aa8\u0abe \u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8\u0aa8\u0abe \u0aaa\u0acd\u0ab0\u0aae\u0abe\u0aa3\u0aae\u0abe\u0a82** \u0ab5\u0ab9\u0ac7\u0a82\u0a9a\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7.\n\n\u0a86 \u0aa8\u0acb\u0a82\u0aa7\u0acb \u0a95\u0ab0\u0ab5\u0abe \u0aae\u0abe\u0a9f\u0ac7 \u0aaa\u0ac7\u0aa2\u0ac0\u0aa8\u0abe \u0a9a\u0acb\u0aaa\u0aa1\u0ac7 \u0a8f\u0a95 \u0a96\u0abe\u0ab8 \u0a96\u0abe\u0aa4\u0ac1\u0a82 \u0a96\u0acb\u0ab2\u0ab5\u0abe\u0aae\u0abe\u0a82 \u0a86\u0ab5\u0ac7 \u0a9b\u0ac7, \u0a9c\u0ac7\u0aa8\u0ac7 **\u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0ac1\u0a82** (\u0a85\u0aa5\u0ab5\u0abe \u0aa8\u0aab\u0abe-\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8 \u0ab9\u0ab5\u0abe\u0ab2\u0abe \u0a96\u0abe\u0aa4\u0ac1\u0a82) \u0a95\u0ab9\u0ac7\u0ab5\u0abe\u0aaf \u0a9b\u0ac7.\n\n**\u0aaa\u0ac1\u0aa8\u0a83\u0aae\u0ac2\u0ab2\u0acd\u0aaf\u0abe\u0a82\u0a95\u0aa8 \u0a96\u0abe\u0aa4\u0abe\u0aa8\u0abe \u0aa8\u0abf\u0aaf\u0aae\u0acb:**\n- **\u0a89\u0aa7\u0abe\u0ab0 \u0aac\u0abe\u0a9c\u0ac1 (\u0aa8\u0ac1\u0a95\u0ab8\u0abe\u0aa8):** \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u0a98\u0a9f\u0abe\u0aa1\u0acb, \u0aa6\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u0ab5\u0aa7\u0abe\u0ab0\u0acb, \u0a9a\u0ac2\u0a95\u0ab5\u0ab5\u0abe\u0aa8\u0abe \u0aac\u0abe\u0a95\u0ac0 \u0a96\u0ab0\u0acd\u0a9a\u0abe.\n- **\u0a9c\u0aae\u0abe \u0aac\u0abe\u0a9c\u0ac1 (\u0aab\u0abe\u0aaf\u0aa6\u0acb):** \u0aae\u0abf\u0ab2\u0a95\u0aa4\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u0ab5\u0aa7\u0abe\u0ab0\u0acb, \u0aa6\u0ac7\u0ab5\u0abe\u0aa8\u0ac0 \u0a95\u0abf\u0a82\u0aae\u0aa4\u0aae\u0abe\u0a82 \u0a98\u0a9f\u0abe\u0aa1\u0acb, \u0aae\u0ab3\u0ab5\u0abe\u0aa8\u0ac0 \u0aac\u0abe\u0a95\u0ac0 \u0a86\u0ab5\u0a95\u0acb."
    },
